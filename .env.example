# Copie para .env.local para rodar com `vercel dev`.
# Em produção, defina estas variáveis no painel da Vercel.
# NUNCA versione o arquivo com os valores reais.

# Obrigatória. Chave da Resend (Dashboard > API Keys).
RESEND_API_KEY=

# Opcional. Remetente. Exige domínio verificado na Resend para produção.
# Sem ela, o endpoint usa o sandbox: "Órbita <onboarding@resend.dev>",
# que só entrega para o e-mail dono da conta Resend.
# Depois de verificar weorbita.com.br, use algo como:
# CONTACT_FROM_EMAIL=Órbita <contato@weorbita.com.br>
CONTACT_FROM_EMAIL=

# Opcional. Destinatário. Padrão: weorbita@gmail.com
CONTACT_TO_EMAIL=
